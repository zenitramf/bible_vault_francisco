# Vault root navigation base (pairs with index.md; does not replace it).
filters:
  or:
    - 'file.path == "AGENTS.md"'
    - 'file.path == "raw/index.md"'
    - 'file.path == "sources/index.md"'
    - 'file.path == "wiki/index.md"'
    - 'file.path == "schema/index.md"'
    - 'file.path == "_templates/index.md"'
    - 'file.path == "bases.base"'

properties:
  title:
    displayName: Title
  description:
    displayName: Summary
  type:
    displayName: Type

views:
  - type: table
    name: "Vault hubs"
    order:
      - file.path
      - file.name
      - type
      - title
      - description

  - type: list
    name: "List"
    order:
      - file.path
      - file.name
