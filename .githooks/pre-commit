#!/usr/bin/env bash
# Lightweight pre-commit gate: rebuild catalog/indexes and lint.
# Does not run qmd embedding or model-heavy retrieval.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "${ROOT}" ]]; then
  echo "pre-commit: not inside a git work tree" >&2
  exit 1
fi
cd "$ROOT"

python3 .tools/scripts/wiki_tool.py build
python3 .tools/scripts/wiki_tool.py lint
python3 .tools/scripts/wiki_tool.py source-lint

# Re-stage generated artifacts if present
for path in wiki/catalog.jsonl wiki/index.md schema/source-manifest.jsonl; do
  if [[ -f "$path" ]]; then
    git add "$path" 2>/dev/null || true
  fi
done
# Stage regenerated wiki indexes
git add wiki/**/index.md 2>/dev/null || true

echo "pre-commit wiki gate passed"
