filters:
  and:
    - file.inFolder("sources")
    - file.ext == "md"
    - file.name != "index.md"
properties:
  title:
    displayName: Title
  description:
    displayName: Summary
  type:
    displayName: Type
  tags:
    displayName: Tags
  bible_book_name:
    displayName: Book
  bible_reference:
    displayName: Reference
  linkTitle:
    displayName: Link title
  weight:
    displayName: Weight
views:
  - type: table
    name: Contents
    order:
      - file.name
      - title
      - type
      - bible_book_name
      - tags
      - description
    summaries:
      file.name: Unique
  - type: table
    name: By book
    groupBy:
      property: bible_book_name
      direction: ASC
    order:
      - file.name
      - title
      - tags
      - description
  - type: table
    name: By type
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - title
      - tags
      - description
  - type: cards
    name: Cards
    order:
      - file.name
      - title
      - tags
      - description
