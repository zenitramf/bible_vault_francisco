# qmd configuration is versioned; its generated local database is not.
.qmd/index.sqlite
.qmd/index.sqlite-*
.qmd/*.sqlite-shm
.qmd/*.sqlite-wal

# Local Python env for Qdrant tooling via uv (not committed).
.tools/venv-qdrant/
.tools/venv-qdrant/**
.tools/.venv/
.tools/.venv/**

# OS / editor noise
.DS_Store
Thumbs.db

# Obsidian local state (preserve vault basics; do not commit plugin/cache churn)
.obsidian/workspace*.json
.obsidian/plugins/
.obsidian/cache/
.obsidian/logs/
.obsidian/graph.json
.obsidian/community-plugins.json
.obsidian/appearance.json
.obsidian/app.json
.obsidian/core-plugins.json
.obsidian/hotkeys.json

# Local drafts and private scratch
Drafts/
drafts/
*.local.md

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
