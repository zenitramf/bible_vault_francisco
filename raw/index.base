# Auto-generated counterpart to index.md in raw.
# Pairs with the static OKF index.md; does not replace it.
filters:
  and:
    - 'file.inFolder("raw")'
    - 'file.ext == "md"'
    - 'file.name != "index.md"'

properties:
  title:
    displayName: Title
  description:
    displayName: Summary
  type:
    displayName: Type
  tags:
    displayName: Tags

views:
  - type: table
    name: "Contents"
    order:
      - file.name
      - type
      - title
      - tags
      - description
    summaries:
      file.name: Unique

  - type: table
    name: "By type"
    order:
      - file.name
      - title
      - description
    groupBy:
      property: type
      direction: ASC

  - type: cards
    name: "Cards"
    order:
      - file.name
      - type
      - description
