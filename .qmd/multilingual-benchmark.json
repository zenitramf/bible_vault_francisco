      ],
      "expected_in_top_k": 8,
      "lang": "en"
    },
    {
      "id": "en-sem-what-sustains-ministry",
      "mode": "semantic-wiki",
      "query": "What sustains Christian ministry and enables the pastor?",
      "expected_substrings": [
