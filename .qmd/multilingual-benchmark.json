{
  "description": "EN/ES lexical and wiki semantic retrieval checks for the bilingual Bible Vault",
  "version": 2,
  "notes": [
    "BM25 is sensitive to multi-term AND density on short Spanish notes; keep lexical queries compact.",
    "Semantic tests use .qmd/bin/semantic-wiki-safe (vec-only, no rerank) against bible-wiki embeddings only.",
    "bible-sources are intentionally not embedded on this server.",
    "bible-personal-notes may be embedded as a bounded pilot; not required for this fixture.",
    "Passage pages (Matthew 6, Romans 8) require update-safe after those wiki files exist."
  ],
  "cases": [
    {
      "id": "es-lex-pastor-ovejas",
      "mode": "lexical",
      "collection": "bible-sources",
      "query": "pastor ovejas",
      "expected_substrings": [
        "personal-notes/THE-PASTOR-AND-HIS-CHURCH",
        "Pastor-Andrés-Gómez",
        "Andrés-Gómez"
      ],
      "expected_in_top_k": 5,
      "lang": "es"
    },
    {
      "id": "es-lex-estudio-biblico-contexto",
      "mode": "lexical",
      "collection": "bible-sources",
      "query": "estudio biblico contexto",
      "expected_substrings": [
        "personal-notes/Ayudas",
        "Ayudas-en-el-estudio"
      ],
      "expected_in_top_k": 5,
      "lang": "es"
    },
    {
      "id": "es-lex-pastor-andy-doss",
      "mode": "lexical",
      "collection": "bible-sources",
      "query": "Pastor Andy Doss",
      "expected_substrings": [
        "personal-notes/Pastor-Andy-Doss",
        "Pastor Andy Doss"
      ],
      "expected_in_top_k": 5,
      "lang": "es"
    },
    {
      "id": "es-lex-andres-gomez",
      "mode": "lexical",
      "collection": "bible-sources",
      "query": "Andrés Gómez",
      "expected_substrings": [
        "personal-notes/THE-PASTOR-AND-HIS-CHURCH",
        "Andrés-Gómez"
      ],
      "expected_in_top_k": 5,
      "lang": "es"
    },
    {
      "id": "en-lex-pastoral-ministry-wiki",
      "mode": "lexical",
      "collection": "bible-wiki",
      "query": "pastoral ministry qualifications flock shepherd",
      "expected_substrings": [
        "concepts/Pastoral Ministry",
        "Pastoral-Ministry"
      ],
      "expected_in_top_k": 5,
      "lang": "en"
    },
    {
      "id": "es-lex-wiki-ovejas-pastor",
      "mode": "lexical",
      "collection": "bible-wiki",
      "query": "ovejas pastor",
      "expected_substrings": [
        "concepts/Pastoral Ministry",
        "Pastoral-Ministry"
      ],
      "expected_in_top_k": 5,
      "lang": "es"
    },
    {
      "id": "es-lex-wiki-andres-gomez",
      "mode": "lexical",
      "collection": "bible-wiki",
      "query": "Andrés Gómez",
      "expected_substrings": [
        "concepts/Pastoral Ministry",
        "Pastoral-Ministry"
      ],
      "expected_in_top_k": 5,
      "lang": "es"
    },
    {
      "id": "en-lex-prayer-intercession",
      "mode": "lexical",
      "collection": "bible-wiki",
      "query": "prayer Spirit intercession John 17",
      "expected_substrings": [
        "concepts/Prayer"
      ],
      "expected_in_top_k": 5,
      "lang": "en"
    },
    {
      "id": "en-lex-matthew-6-passage",
      "mode": "lexical",
      "collection": "bible-wiki",
      "query": "Matthew 6 secret prayer hypocrisy",
      "expected_substrings": [
        "passages/Matthew 6",
