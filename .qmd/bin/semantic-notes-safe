#!/usr/bin/env bash
# Vector-only search against the personal-notes pilot collection.
# Requires embed-notes-safe to have been run. No rerank / no expansion.
set -euo pipefail

if (( $# == 0 )); then
  printf 'Usage: %s <query> [qmd query options]\n' "$0" >&2
  exit 2
fi

query=$1
shift

cd /home/hermes/bible_vault_francisco

minimum_available_kib=786432  # 768 MiB
available_kib=$(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo)

if (( available_kib < minimum_available_kib )); then
  printf 'Refusing semantic notes search: MemAvailable is %s KiB; at least %s KiB is required.\n' \
    "$available_kib" "$minimum_available_kib" >&2
  exit 1
fi

exec systemd-run --user --scope --quiet \
  -p MemoryHigh=700M \
  -p MemoryMax=900M \
  -p CPUQuota=50% \
  -p IOWeight=10 \
  env QMD_FORCE_CPU=1 QMD_EMBED_PARALLELISM=1 \
  timeout 3m qmd query "vec: $query" \
    --no-rerank \
    -c bible-personal-notes \
    "$@"
