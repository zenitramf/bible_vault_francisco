#!/usr/bin/env python3
"""Merge catalog + BM25 wiki + vector wiki hits under resource-safe defaults.

Usage:
  .qmd/bin/search-wiki-safe "natural language or keywords" [options]

Options:
  --limit N          Max merged hits to print (default 10)
  --lex-n N          BM25 candidates (default 10)
  --vec-n N          Vector candidates (default 8)
  --catalog-n N      Catalog candidates (default 8)
  --no-catalog       Skip wiki_tool search-catalog
  --no-lexical       Skip qmd BM25 search
  --no-semantic      Skip semantic-wiki-safe
  --json             Emit JSON only
  --format json      Alias for --json (qmd-style)

Does not load query-expansion or rerank models. Semantic path uses
semantic-wiki-safe (vec: + --no-rerank + cgroup limits).
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from pathlib import Path
from typing import Any
from urllib.parse import unquote


ROOT = Path(__file__).resolve().parents[2]
WIKI_TOOL = ROOT / ".tools" / "scripts" / "wiki_tool.py"
SEMANTIC = ROOT / ".qmd" / "bin" / "semantic-wiki-safe"


def run(cmd: list[str], timeout: int = 120) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        cmd,
        cwd=ROOT,
        capture_output=True,
        text=True,
        timeout=timeout,
        check=False,
    )


def parse_json_payload(stdout: str) -> list[dict[str, Any]]:
    text = stdout.strip()
    if not text:
        return []
    try:
        data = json.loads(text)
        return data if isinstance(data, list) else []
    except json.JSONDecodeError:
        start = text.find("[")
        end = text.rfind("]")
        if start >= 0 and end > start:
            data = json.loads(text[start : end + 1])
            return data if isinstance(data, list) else []
        return []


def normalize_wiki_path(file_uri: str) -> str:
    """Map qmd://bible-wiki/... or bare path to wiki/... disk-ish path."""
    s = unquote(str(file_uri or "").strip())
    s = re.sub(r"^qmd://bible-wiki/", "wiki/", s)
    s = re.sub(r"^qmd://[^/]+/", "", s)
    if s.startswith("wiki/"):
        return s
    if s and not s.startswith("sources/"):
        # collection-relative
        return f"wiki/{s.lstrip('/')}"
    return s


def path_key(path: str) -> str:
    p = normalize_wiki_path(path).lower()
    p = p.replace("\\", "/")
    if not p.endswith(".md"):
        p = f"{p}.md"
    # collapse spaces / hyphens lightly for dedupe
    return p


def catalog_hits(query: str, limit: int) -> list[dict[str, Any]]:
    if not WIKI_TOOL.is_file():
        return []
    proc = run(
        [
            sys.executable,
            str(WIKI_TOOL),
            "search-catalog",
            "--query",
            query,
            "--limit",
            str(limit),
        ],
        timeout=60,
    )
    hits: list[dict[str, Any]] = []
    if proc.returncode != 0:
        return hits
    # Parse CLI lines: "  [19.3] wiki/concepts/Prayer.md — Prayer (Biblical Concept)"
    for line in proc.stdout.splitlines():
        m = re.match(
            r"\s*\[([0-9.]+)\]\s+(\S+\.md)\s+—\s+(.+?)\s+\(([^)]+)\)\s*$",
            line,
        )
        if not m:
            continue
        score = float(m.group(1))
        path = m.group(2)
        title = m.group(3)
        ptype = m.group(4)
        hits.append(
            {
                "channel": "catalog",
                "score": score,
                "path": path,
                "title": title,
                "type": ptype,
                "file": path,
                "snippet": "",
            }
        )
    return hits


def lexical_hits(query: str, limit: int) -> list[dict[str, Any]]:
    proc = run(
        [
            "qmd",
            "search",
            query,
            "-c",
            "bible-wiki",
            "--format",
            "json",
            "-n",
            str(limit),
        ],
        timeout=90,
    )
    if proc.returncode != 0:
        return []
    out: list[dict[str, Any]] = []
    for i, hit in enumerate(parse_json_payload(proc.stdout)):
        path = normalize_wiki_path(str(hit.get("file", "")))
        raw_score = hit.get("score")
        try:
            score = float(raw_score) if raw_score is not None else 0.0
        except (TypeError, ValueError):
            score = 0.0
        # BM25 sometimes reports 0; use rank fallback
        if score <= 0:
            score = max(0.1, 1.0 - i * 0.05)
        out.append(
            {
                "channel": "lexical",
                "score": score,
                "path": path,
                "title": hit.get("title") or Path(path).stem,
                "file": hit.get("file") or path,
                "snippet": hit.get("snippet") or "",
                "line": hit.get("line"),
                "docid": hit.get("docid"),
            }
        )
    return out


def semantic_hits(query: str, limit: int) -> list[dict[str, Any]]:
    if not SEMANTIC.is_file():
        return []
    proc = run(
        [str(SEMANTIC), query, "--format", "json", "-n", str(limit)],
        timeout=180,
    )
    if proc.returncode != 0:
        # Soft-fail: return empty so catalog/lexical still useful
        return []
    out: list[dict[str, Any]] = []
    for i, hit in enumerate(parse_json_payload(proc.stdout)):
        path = normalize_wiki_path(str(hit.get("file", "")))
        raw_score = hit.get("score")
        try:
            score = float(raw_score) if raw_score is not None else 0.0
        except (TypeError, ValueError):
            score = 0.0
        if score <= 0:
            score = max(0.1, 1.0 - i * 0.05)
        out.append(
            {
                "channel": "semantic",
                "score": score,
                "path": path,
                "title": hit.get("title") or Path(path).stem,
                "file": hit.get("file") or path,
                "snippet": hit.get("snippet") or "",
                "line": hit.get("line"),
                "docid": hit.get("docid"),
            }
        )
    return out


# Channel weights: catalog is structured truth; semantic helps paraphrase; lexical phrases
WEIGHT = {
    "catalog": 1.15,
    "lexical": 1.0,
    "semantic": 1.05,
}


def merge_hits(
    groups: list[list[dict[str, Any]]],
    limit: int,
) -> list[dict[str, Any]]:
    by_key: dict[str, dict[str, Any]] = {}
    for group in groups:
        for hit in group:
            path = str(hit.get("path") or hit.get("file") or "")
            if not path:
                continue
            key = path_key(path)
            channel = str(hit.get("channel") or "unknown")
            weighted = float(hit.get("score") or 0) * WEIGHT.get(channel, 1.0)
            if key not in by_key:
                by_key[key] = {
                    "path": normalize_wiki_path(path),
                    "title": hit.get("title") or Path(path).stem,
                    "score": weighted,
                    "channels": [channel],
                    "snippets": [hit.get("snippet") or ""] if hit.get("snippet") else [],
                    "files": [hit.get("file")] if hit.get("file") else [],
                    "type": hit.get("type"),
                }
            else:
                row = by_key[key]
                row["score"] = float(row["score"]) + weighted
                if channel not in row["channels"]:
                    row["channels"].append(channel)
                snip = hit.get("snippet") or ""
                if snip and snip not in row["snippets"]:
                    row["snippets"].append(snip)
                f = hit.get("file")
                if f and f not in row["files"]:
                    row["files"].append(f)
                if not row.get("type") and hit.get("type"):
                    row["type"] = hit.get("type")
                # prefer longer title
                t = str(hit.get("title") or "")
                if t and len(t) > len(str(row.get("title") or "")):
                    row["title"] = t

    ranked = sorted(by_key.values(), key=lambda r: (-float(r["score"]), r["path"]))
    return ranked[:limit]


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Resource-safe merged wiki search")
    parser.add_argument("query", help="Search query")
    parser.add_argument("--limit", type=int, default=10)
    parser.add_argument("--lex-n", type=int, default=10)
    parser.add_argument("--vec-n", type=int, default=8)
    parser.add_argument("--catalog-n", type=int, default=8)
    parser.add_argument("--no-catalog", action="store_true")
    parser.add_argument("--no-lexical", action="store_true")
    parser.add_argument("--no-semantic", action="store_true")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--format", choices=["text", "json"], default=None)
    args = parser.parse_args(argv)

    as_json = args.json or args.format == "json"
    query = args.query.strip()
    if not query:
        print("ERROR empty query", file=sys.stderr)
        return 2

    groups: list[list[dict[str, Any]]] = []
    errors: list[str] = []

    if not args.no_catalog:
        try:
            groups.append(catalog_hits(query, args.catalog_n))
        except Exception as exc:  # noqa: BLE001
            errors.append(f"catalog: {exc}")

    if not args.no_lexical:
        try:
            groups.append(lexical_hits(query, args.lex_n))
        except Exception as exc:  # noqa: BLE001
            errors.append(f"lexical: {exc}")

    if not args.no_semantic:
        try:
            groups.append(semantic_hits(query, args.vec_n))
        except Exception as exc:  # noqa: BLE001
            errors.append(f"semantic: {exc}")

    merged = merge_hits(groups, args.limit)

    if as_json:
        payload = {
            "query": query,
            "hits": merged,
            "errors": errors,
            "channels": {
                "catalog": 0 if args.no_catalog else len(groups[0]) if groups else 0,
            },
        }
        # recount channels properly
        channel_counts = {"catalog": 0, "lexical": 0, "semantic": 0}
        idx = 0
        if not args.no_catalog:
            channel_counts["catalog"] = len(groups[idx]) if idx < len(groups) else 0
            idx += 1
        if not args.no_lexical:
            channel_counts["lexical"] = len(groups[idx]) if idx < len(groups) else 0
            idx += 1
        if not args.no_semantic:
            channel_counts["semantic"] = len(groups[idx]) if idx < len(groups) else 0
        payload["channels"] = channel_counts
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        print(f"Merged wiki search for {query!r} ({len(merged)} hit(s))")
        if errors:
            for err in errors:
                print(f"WARN {err}", file=sys.stderr)
        for i, hit in enumerate(merged, 1):
            channels = ",".join(hit.get("channels") or [])
            print(f"  [{i}] {hit['score']:.2f} {hit['path']} — {hit.get('title')}")
            print(f"       channels: {channels}")
            snips = [s for s in (hit.get("snippets") or []) if s]
            if snips:
                one = snips[0].replace("\n", " ")
                if len(one) > 160:
                    one = one[:157] + "..."
                print(f"       {one}")

    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except subprocess.TimeoutExpired:
        print("ERROR search timed out", file=sys.stderr)
        sys.exit(1)
