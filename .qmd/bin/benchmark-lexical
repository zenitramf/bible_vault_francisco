#!/usr/bin/env python3
"""Run the Bible Vault BM25 benchmark without loading local LLM models."""

from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[2]
FIXTURE = ROOT / ".qmd" / "lexical-benchmark.json"


def main() -> int:
    fixture = json.loads(FIXTURE.read_text(encoding="utf-8"))
    collection = fixture["collection"]
    failures = 0

    for case in fixture["queries"]:
        top_k = int(case.get("expected_in_top_k", 5))
        command = [
            "qmd",
            "search",
            case["query"],
            "-c",
            collection,
            "--format",
            "json",
            "-n",
            str(top_k),
        ]
        result = subprocess.run(
            command,
            cwd=ROOT,
            check=True,
            capture_output=True,
            text=True,
        )
        hits = json.loads(result.stdout)
        prefix = f"qmd://{collection}/"
        returned = {
            str(hit.get("file", "")).removeprefix(prefix)
            for hit in hits
        }
        expected = set(case["expected_files"])
        passed = bool(returned & expected)
        print(f"{'PASS' if passed else 'FAIL'} {case['id']}")
        if not passed:
            failures += 1
            print(f"  expected one of: {sorted(expected)}")
            print(f"  returned: {sorted(returned)}")

    total = len(fixture["queries"])
    print(f"{total - failures}/{total} lexical retrieval checks passed")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
