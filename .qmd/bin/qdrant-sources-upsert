#!/usr/bin/env bash
# Embed + upsert source chunks via Qdrant Cloud Inference (default: mhenry-concise).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
# shellcheck source=/dev/null
source "${ROOT}/.tools/scripts/qdrant-env.sh"

if [[ -z "${QCLOUD_BIBLE_CLUSTER_API_KEY:-${QDRANT_API_KEY:-}}" ]]; then
  printf 'Missing QCLOUD_BIBLE_CLUSTER_API_KEY (or QDRANT_API_KEY).\n' >&2
  exit 2
fi

qdrant_exec "${ROOT}/.tools/scripts/qdrant_sources_upsert.py" "$@"
