#!/usr/bin/env bash
# Upsert wiki pages into Qdrant wiki_bm25 (sparse BM25).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
VENV="${ROOT}/.tools/venv-qdrant"
if [[ ! -x "${VENV}/bin/python" ]]; then
  printf 'Missing %s — create with:\n  python3 -m venv %s && %s/bin/pip install -r %s/.tools/requirements-qdrant.txt\n' \
    "${VENV}/bin/python" "${VENV}" "${VENV}" "${ROOT}" >&2
  exit 1
fi
exec "${VENV}/bin/python" "${ROOT}/.tools/scripts/qdrant_wiki_upsert.py" "$@"
