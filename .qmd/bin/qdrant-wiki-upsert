#!/usr/bin/env bash
# Upsert wiki pages into Qdrant wiki_bm25 (Cloud Inference BM25).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
# shellcheck source=/dev/null
source "${ROOT}/.tools/scripts/qdrant-env.sh"

if [[ -z "${QCLOUD_BIBLE_CLUSTER_API_KEY:-${QDRANT_API_KEY:-}}" ]]; then
  printf 'Missing QCLOUD_BIBLE_CLUSTER_API_KEY (or QDRANT_API_KEY).\n' >&2
  exit 2
fi

qdrant_exec "${ROOT}/.tools/scripts/qdrant_wiki_upsert.py" "$@"
