#!/usr/bin/env bash
# Dense E5 search over sources_e5 (Cloud Inference).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
# shellcheck source=/dev/null
source "${ROOT}/.tools/scripts/qdrant-env.sh"

if (( $# == 0 )); then
  printf 'Usage: %s <query> [--limit N] [--corpus mhenry-concise] [--json]\n' "$0" >&2
  exit 2
fi

if [[ -z "${QCLOUD_BIBLE_CLUSTER_API_KEY:-${QDRANT_API_KEY:-}}" ]]; then
  printf 'Missing QCLOUD_BIBLE_CLUSTER_API_KEY (or QDRANT_API_KEY).\n' >&2
  exit 2
fi

qdrant_exec "${ROOT}/.tools/scripts/qdrant_sources_search.py" "$@"
