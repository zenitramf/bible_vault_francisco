#!/usr/bin/env bash
# Sparse BM25 search over wiki_bm25 (Cloud Inference).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
# shellcheck source=/dev/null
source "${ROOT}/.tools/scripts/qdrant-env.sh"

if (( $# == 0 )); then
  printf 'Usage: %s <query> [--limit N] [--json] [--page-type concept]\n' "$0" >&2
  exit 2
fi

if [[ -z "${QCLOUD_BIBLE_CLUSTER_API_KEY:-${QDRANT_API_KEY:-}}" ]]; then
  printf 'Missing QCLOUD_BIBLE_CLUSTER_API_KEY (or QDRANT_API_KEY).\n' >&2
  exit 2
fi

qdrant_exec "${ROOT}/.tools/scripts/qdrant_wiki_search.py" "$@"
