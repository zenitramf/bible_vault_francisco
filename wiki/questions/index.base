# Auto-generated counterpart to index.md in wiki/questions.
# Pairs with the static OKF index.md; does not replace it.
filters:
  and:
    - 'file.inFolder("wiki/questions")'
    - 'file.ext == "md"'
    - 'file.name != "index.md"'

formulas:
  maturity: 'if(status == "reviewed", "✅ Reviewed", if(status == "developing", "🔨 Developing", if(status, "🌱 " + status, "")))'

properties:
  title:
    displayName: Title
  description:
    displayName: Summary
  type:
    displayName: Type
  tags:
    displayName: Tags
  status:
    displayName: Status
  source_count:
    displayName: Sources
  bible_book_name:
    displayName: Book
  bible_reference:
    displayName: Reference
  updated:
    displayName: Updated
  formula.maturity:
    displayName: Maturity

views:
  - type: table
    name: "Contents"
    order:
      - file.name
      - type
      - formula.maturity
      - tags
      - source_count
      - bible_book_name
      - description
    summaries:
      source_count: Sum
      file.name: Unique

  - type: table
    name: "By type"
    order:
      - file.name
      - status
      - tags
      - description
    groupBy:
      property: type
      direction: ASC

  - type: table
    name: "By book"
    order:
      - file.name
      - tags
      - status
      - description
    groupBy:
      property: bible_book_name
      direction: ASC

  - type: cards
    name: "Cards"
    order:
      - file.name
      - type
      - tags
      - description
