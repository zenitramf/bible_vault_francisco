# Dynamic index of wiki source notes (pairs with index.md; does not replace it).
filters:
  and:
    - 'file.inFolder("wiki/source-notes")'
    - 'file.ext == "md"'
    - 'file.name != "index.md"'
    - 'type == "Source Note"'

formulas:
  maturity: 'if(status == "reviewed", "✅ Reviewed", if(status == "developing", "🔨 Developing", "🌱 Seed"))'

properties:
  title:
    displayName: Title
  description:
    displayName: Summary
  tags:
    displayName: Tags
  status:
    displayName: Status
  source_count:
    displayName: Sources
  source_path:
    displayName: Source path
  bible_book_name:
    displayName: Book
  updated:
    displayName: Updated
  formula.maturity:
    displayName: Maturity

views:
  - type: table
    name: "All source notes"
    order:
      - file.name
      - formula.maturity
      - tags
      - source_count
      - bible_book_name
      - source_path
      - description
    summaries:
      source_count: Sum
      file.name: Unique

  - type: table
    name: "By book"
    order:
      - file.name
      - tags
      - source_count
      - description
    groupBy:
      property: bible_book_name
      direction: ASC

  - type: table
    name: "By status"
    order:
      - file.name
      - tags
      - source_count
      - description
    groupBy:
      property: status
      direction: ASC

  - type: cards
    name: "Cards"
    order:
      - file.name
      - formula.maturity
      - tags
      - description
